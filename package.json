{
  "name": "loom-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && vite build",
    "lint": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json && prettier --check src scripts tests *.json *.ts index.html",
    "format": "prettier --write src scripts tests *.json *.ts index.html",
    "test": "node --test dist-node/tests/*.test.js",
    "bench": "node dist-node/scripts/bench.js",
    "start": "node dist-node/src/server.js"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/ws": "8.18.2",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "prettier": "3.9.10"
  }
}
